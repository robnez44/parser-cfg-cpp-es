# Grammar for arithmetic expressions without left recursion (Aho et al., "Compilers", section 4.4)
# LL(1). Known sets:
#   FIRST(E) = FIRST(T) = FIRST(F) = { (, id }   FIRST(E') = { +, ε }   FIRST(T') = { *, ε }
#   FOLLOW(E) = FOLLOW(E') = { ), $ }   FOLLOW(T) = FOLLOW(T') = { +, ), $ }   FOLLOW(F) = { +, *, ), $ }
E -> T E'
E' -> + T E' | ε
T -> F T'
T' -> * F T' | ε
F -> ( E ) | id
